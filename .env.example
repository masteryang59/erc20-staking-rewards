# Copy to .env. Nothing here is needed for `npm test`, `npm run demo` or `npm run gas:report`,
# which all run on Hardhat's in-process chain.

# --- scripts/deploy.ts ------------------------------------------------------------
# JSON-RPC endpoint for `--network localhost` (`npm run node`, or the chain service in compose).
RPC_URL=http://127.0.0.1:8545
REWARDS_DURATION_DAYS=7
# Reward to fund right after deploying (whole tokens). 0 = deploy only.
INITIAL_REWARD=70000
# true = stake and earn the same token (enables compound()).
SAME_TOKEN=false
# Use existing tokens instead of deploying fresh StakeTokens (leave empty for fresh ones).
STAKING_TOKEN=
REWARDS_TOKEN=
# Defaults to the deployer.
POOL_OWNER=
REWARDS_DISTRIBUTOR=

# --- Sepolia (`npx hardhat run scripts/deploy.ts --network sepolia`) ------------------
SEPOLIA_RPC_URL=
# Use a throwaway testnet key. Never put a mainnet key in a file.
SEPOLIA_PRIVATE_KEY=

# --- Sandboxes only -----------------------------------------------------------------
# Put cache/ and artifacts/ elsewhere if something blocks renames in the project folder.
# HARDHAT_OUT_DIR=
ROLLBACK_CHANGES=enabled
AUDIT_ACTION=enabled
CHECK_STATUS=enabled
ROLLBACK_CHANGES=enabled
AUDIT_ACTION=enabled